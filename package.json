{
	"name": "ariadne",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "electron/main/dist/index.cjs",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"dev:renderer": "vite",
		"dev:legacy": "bun run build:electron && concurrently -k \"bun run dev:renderer\" \"sleep 2 && NODE_ENV=development electron .\"",
		"build": "bun run build:renderer",
		"build:renderer": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
		"check": "bun run typecheck && bun run test && bun run test:parity:all",
		"build:backend": "esbuild backend/index.ts --bundle --platform=node --outfile=backend/dist/index.js --format=esm --external:electron --external:better-sqlite3 && esbuild backend/workers/analytics-build.worker.ts --bundle --platform=node --outfile=backend/dist/analytics-build.worker.js --format=esm",
		"build:preload": "esbuild electron/preload/index.ts --bundle --platform=node --outfile=electron/preload/dist/index.js --format=cjs --external:electron",
		"build:qmd-bridge": "esbuild src-sidecar/qmd-bridge.ts --bundle --platform=node --outfile=src-sidecar/dist/qmd-bridge.js --format=esm --external:better-sqlite3 --external:sqlite-vec --external:node-llama-cpp --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
		"build:electron": "bun run build:backend && bun run build:preload && bun run build:qmd-bridge && esbuild electron/main/index.ts --bundle --platform=node --outfile=electron/main/dist/index.cjs --external:electron --format=cjs",
		"electron:build": "bun run build && bun run build:electron && electron-builder",
		"package": "bun run electron:build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:parity": "TZ=UTC bun test tests/parity/run-parity.test.ts",
		"test:parity:qmd": "TZ=UTC ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/Electron.app/Contents/MacOS/Electron node_modules/vitest/vitest.mjs run --config vitest.config.parity-qmd.ts",
		"test:parity:all": "bun run test:parity && bun run test:parity:qmd",
		"lint": "bunx @biomejs/biome check .",
		"lint:fix": "bunx @biomejs/biome check --write .",
		"format": "bunx @biomejs/biome format --write .",
		"postinstall": "electron-rebuild --only better-sqlite3"
	},
	"dependencies": {
		"better-sqlite3": "^12.8.0"
	},
	"devDependencies": {
		"@base-ui/react": "^1.3.0",
		"@biomejs/biome": "2.4.11",
		"@electron/rebuild": "^4.0.3",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/react-router": "^1.168.0",
		"@tanstack/react-table": "^8.21.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.5.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^4.6.0",
		"@vitest/coverage-v8": "^4.1.4",
		"bun-types": "^1.3.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"date-fns": "^4.1.0",
		"electron": "^41.2.0",
		"electron-builder": "^26.8.1",
		"esbuild": "^0.28.0",
		"lucide-react": "^1.8.0",
		"motion": "^12.38.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.9.0",
		"react-syntax-highlighter": "^16.1.1",
		"recharts": "3.8.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.2.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vitest": "^4.1.4",
		"zod": "^4.3.6"
	}
}
